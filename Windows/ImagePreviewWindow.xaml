<Window x:Class="UnturnedModManager.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="图片预览"
        Width="1040"
        Height="760"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#FF181818"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Padding="14,10" Background="#E6171717">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="图片预览" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Text="滚轮浏览 · Ctrl + 滚轮缩放 · Esc 关闭" Margin="14,0,0,0" FontSize="12" Foreground="#CFFFFFFF" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="−" Width="36" Height="32" Click="ZoomOut_Click" ToolTip="缩小" />
                    <Slider x:Name="ZoomSlider" Width="160" Minimum="0.25" Maximum="3" Value="1" SmallChange="0.1" LargeChange="0.25" TickFrequency="0.25" Margin="8,0" ValueChanged="ZoomSlider_ValueChanged" VerticalAlignment="Center" />
                    <ui:Button Content="100%" MinWidth="58" Height="32" Click="ResetZoom_Click" ToolTip="恢复原始比例" />
                    <ui:Button Content="关闭" MinWidth="64" Height="32" Margin="8,0,0,0" Click="Close_Click" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer x:Name="ImageScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="Both"
                      Background="#FF101010">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="26">
                <Image x:Name="PreviewImage"
                       Source="{Binding ImageUrl}"
                       Stretch="None"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.LayoutTransform>
                        <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1" />
                    </Image.LayoutTransform>
                </Image>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
