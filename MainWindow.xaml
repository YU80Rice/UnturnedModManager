<ui:FluentWindow x:Class="UnturnedModManager.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
 xmlns:controls="clr-namespace:UnturnedModManager.Controls"
 xmlns:motion="clr-namespace:UnturnedModManager.Controls.Motion"
 Title="Unturned Mod Manager" Height="820" Width="1280" MinHeight="620" MinWidth="1000"
 WindowBackdropType="None" WindowCornerPreference="Round" ExtendsContentIntoTitleBar="True"
 WindowStartupLocation="CenterScreen" AllowDrop="True" PreviewDragEnter="Window_PreviewDragEnter"
 PreviewDragOver="Window_PreviewDragOver" PreviewDrop="Window_PreviewDrop" PreviewKeyDown="Window_PreviewKeyDown">
 <ui:FluentWindow.Resources>
  <Style x:Key="ShellTab" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
   <Setter Property="Background" Value="Transparent" />
   <Setter Property="MinHeight" Value="28" />
   <Setter Property="Padding" Value="12,0" />
   <Setter Property="VerticalContentAlignment" Value="Center" />
   <Setter Property="HorizontalContentAlignment" Value="Center" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Border x:Name="Surface" CornerRadius="14" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
       <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppCardBackgroundBrush2}" /></Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Surface" Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AppPillSelectedForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" /></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="ShellPill" TargetType="Border">
   <Setter Property="CornerRadius" Value="14" />
   <Setter Property="Padding" Value="11,5" />
   <Setter Property="Background" Value="{DynamicResource AppPillBackgroundBrush}" />
   <Setter Property="BorderBrush" Value="{DynamicResource AppPillBorderBrush}" />
   <Setter Property="BorderThickness" Value="1" />
   <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="LaunchButtonStyle" TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
   <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
   <Setter Property="BorderBrush" Value="{DynamicResource AppAccentButtonBorderBrush}" />
   <Setter Property="Height" Value="46" />
   <Setter Property="Padding" Value="28,0" />
   <Setter Property="FontSize" Value="15" />
   <Setter Property="FontWeight" Value="Bold" />
   <Setter Property="VerticalAlignment" Value="Center" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" /></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentFillColorTertiaryBrush}" /></Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" /></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppPillBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" /></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </ui:FluentWindow.Resources>
 <Grid ClipToBounds="True">
  <Border Background="{DynamicResource ApplicationBackgroundBrush}" />
  <Image x:Name="WallpaperImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" IsHitTestVisible="False">
   <Image.Effect><BlurEffect x:Name="WallpaperBlurEffect" Radius="15" RenderingBias="Performance" /></Image.Effect>
  </Image>
  <Border x:Name="WallpaperDimOverlay" Background="{DynamicResource ApplicationBackgroundBrush}" Opacity="0.35" Visibility="Collapsed" IsHitTestVisible="False" />
  <!-- Layer 3: 页面和外壳浮在已调光的壁纸上；Frame 不参与返回历史。 -->
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="40" /><RowDefinition Height="54" /><RowDefinition Height="*" /><RowDefinition Height="70" /></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="{DynamicResource AppCommandBarSurfaceBrush}" />
   <ui:TitleBar Grid.Row="0" Title="Unturned Mod Manager" ShowMaximize="True" ShowMinimize="True" ShowClose="True" />
   <Border Grid.Row="1" BorderThickness="0,1,0,1" BorderBrush="{DynamicResource AppCommandBarBorderBrush}">
    <Grid Margin="20,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border Style="{StaticResource ShellPill}">
       <StackPanel Orientation="Horizontal"><Ellipse x:Name="SteamStatusDot" Width="7" Height="7" Margin="0,0,6,0" Fill="{DynamicResource AppWarningTextBrush}" /><TextBlock x:Name="SteamStatusText" Text="Unturned · Steam 304930" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></StackPanel>
      </Border>
      <ToggleButton x:Name="AccentButton" Margin="8,0,0,0" Width="30" Height="30" Background="{DynamicResource AppPillBackgroundBrush}" BorderBrush="{DynamicResource AppPillBorderBrush}" ToolTip="主题调色" AutomationProperties.Name="主题调色">
       <Ellipse Width="14" Height="14" Fill="{DynamicResource AccentFillColorDefaultBrush}" Stroke="{DynamicResource AppAccentBorderBrush}" />
      </ToggleButton>
      <Popup x:Name="AccentPopup" IsOpen="{Binding IsChecked, ElementName=AccentButton, Mode=TwoWay}" PlacementTarget="{Binding ElementName=AccentButton}" Placement="Bottom" VerticalOffset="8" AllowsTransparency="True" StaysOpen="False" Opened="AccentPopup_Opened" Closed="AccentPopup_Closed">
       <Border MinWidth="260" Padding="12" CornerRadius="12" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
        <StackPanel>
         <TextBlock Text="色环快速选色" FontWeight="SemiBold" Margin="0,0,0,8" />
         <controls:ColorWheelControl x:Name="AccentWheel" RingSize="140" AccentColorChanged="AccentWheel_AccentColorChanged" />
        </StackPanel>
       </Border>
      </Popup>
     </StackPanel>
     <Border Grid.Column="1" Style="{StaticResource ShellPill}" Padding="3">
      <Grid motion:SegmentedIndicator.IsEnabled="True">
       <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle">
        <RadioButton x:Name="PlayTab" GroupName="ShellSlots" Tag="Play" Style="{StaticResource ShellTab}" Click="NavigationTab_Click" AutomationProperties.Name="开始游戏">
         <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Home24" FontSize="16" /><TextBlock Margin="6,0,0,0" Text="开始游戏" /></StackPanel>
        </RadioButton>
        <RadioButton x:Name="ModsTab" GroupName="ShellSlots" Tag="Mods" Style="{StaticResource ShellTab}" Click="NavigationTab_Click" AutomationProperties.Name="模组工坊">
         <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Box24" FontSize="16" /><TextBlock Margin="6,0,0,0" Text="模组工坊" /></StackPanel>
        </RadioButton>
        <RadioButton x:Name="TasksTab" GroupName="ShellSlots" Tag="TaskCenter" Style="{StaticResource ShellTab}" Click="NavigationTab_Click" AutomationProperties.Name="任务中心">
         <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" /><TextBlock Margin="6,0,0,0" Text="任务中心" /><Border x:Name="TaskBadge" Margin="5,0,0,0" MinWidth="18" Padding="3,0" CornerRadius="7" Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed"><TextBlock x:Name="TaskBadgeText" FontSize="10" TextAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" /></Border></StackPanel>
        </RadioButton>
        <RadioButton x:Name="SettingsTab" GroupName="ShellSlots" Tag="Settings" Style="{StaticResource ShellTab}" Click="NavigationTab_Click" AutomationProperties.Name="游戏设置">
         <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" FontSize="16" /><TextBlock Margin="6,0,0,0" Text="游戏设置" /></StackPanel>
        </RadioButton>
        <RadioButton x:Name="AboutTab" GroupName="ShellSlots" Tag="About" Style="{StaticResource ShellTab}" Click="NavigationTab_Click" AutomationProperties.Name="关于">
         <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Info24" FontSize="16" /><TextBlock Margin="6,0,0,0" Text="关于" /></StackPanel>
        </RadioButton>
       </StackPanel>
      </Grid>
     </Border>
     <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <ui:Button x:Name="ThemeToggleButton" Width="34" Height="32" Padding="0" Appearance="Transparent" Click="ThemeToggleButton_Click" AutomationProperties.Name="切换深色或浅色" ToolTip="切换深色/浅色主题">
       <ui:SymbolIcon x:Name="ThemeToggleButtonIcon" Symbol="WeatherMoon24" FontSize="16" RenderTransformOrigin="0.5,0.5">
        <ui:SymbolIcon.RenderTransform><RotateTransform x:Name="ThemeToggleButtonRotation" /></ui:SymbolIcon.RenderTransform>
       </ui:SymbolIcon>
      </ui:Button>
      <ui:Button x:Name="AccountButton" Margin="8,0,0,0" Height="32" Padding="4,2,10,2" CornerRadius="16" Background="{DynamicResource AppPillBackgroundBrush}" BorderBrush="{DynamicResource AppPillBorderBrush}" Click="AccountButton_Click" AutomationProperties.Name="社区账户" ToolTip="社区账户">
       <StackPanel Orientation="Horizontal">
        <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}">
         <Grid><Image x:Name="AccountAvatarImage" Stretch="UniformToFill" Visibility="Collapsed"><Image.Clip><EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" /></Image.Clip></Image><TextBlock x:Name="AccountAvatarText" Text="?" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
        </Border>
        <TextBlock x:Name="AccountNameText" Text="登录社区账户" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" MaxWidth="125" TextTrimming="CharacterEllipsis" />
       </StackPanel>
      </ui:Button>
     </StackPanel>
    </Grid>
   </Border>
   <Frame x:Name="PageHost" Grid.Row="2" NavigationUIVisibility="Hidden" JournalOwnership="OwnsJournal" Background="Transparent" Navigated="PageHost_Navigated" />
   <Border Grid.Row="3" Background="{DynamicResource AppCommandBarSurfaceBrush}" BorderBrush="{DynamicResource AppCommandBarBorderBrush}" BorderThickness="0,1,0,0" Padding="24,0">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <WrapPanel Margin="0,0,12,0" VerticalAlignment="Center">
      <Border Style="{StaticResource ShellPill}" Background="{DynamicResource AppAccentSoftBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" Margin="0,0,10,0">
       <StackPanel Orientation="Horizontal"><Ellipse x:Name="ProfileStatusDot" Width="7" Height="7" Margin="0,0,6,0" Fill="{DynamicResource AppSuccessTextBrush}" /><TextBlock x:Name="ProfileSummaryText" Text="方案：默认方案 · 0 插件 (纯净)" MaxWidth="280" TextTrimming="CharacterEllipsis" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" /></StackPanel>
      </Border>
      <Border Style="{StaticResource ShellPill}" Margin="0,0,10,0"><TextBlock x:Name="RunModeText" Text="纯净模式 · Unturned_BE.exe" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></Border>
      <Border Style="{StaticResource ShellPill}"><TextBlock x:Name="EnvironmentText" Text="BepInEx 未安装 · 原生 D3D11" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></Border>
     </WrapPanel>
     <Button x:Name="LaunchButton" Grid.Column="1" Style="{StaticResource LaunchButtonStyle}" Click="LaunchButton_Click" IsEnabled="False" AutomationProperties.Name="开始游戏">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="21" Height="21" Margin="0,0,8,0"><Path Data="M5,3 L19,12 L5,21 Z" Fill="{Binding Foreground, ElementName=LaunchButton}" /></Viewbox><TextBlock x:Name="LaunchButtonText" VerticalAlignment="Center" Text="开始游戏" /></StackPanel>
     </Button>
    </Grid>
   </Border>
  <ItemsControl x:Name="ToastHost" Grid.Row="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,24,4"
                Panel.ZIndex="100"
                IsHitTestVisible="True">
   <ItemsControl.ItemsPanel>
    <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
   </ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate>
    <DataTemplate>
     <Border Width="360"
             Margin="0,0,0,10"
             Padding="16,13"
             CornerRadius="12"
             Background="{DynamicResource ControlFillColorDefaultBrush}"
             BorderBrush="{DynamicResource ToastNotificationBorderBrush}"
             BorderThickness="4,1,1,1"
             Cursor="Hand"
             Loaded="ToastBorder_Loaded"
             MouseLeftButtonUp="ToastBorder_MouseLeftButtonUp">
      <StackPanel>
       <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
       <TextBlock Text="{Binding Message}"
                  Margin="0,4,0,0"
                  TextWrapping="Wrap"
                  Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
       <TextBlock Text="点击通知可打开诊断包目录"
                  Margin="0,7,0,0"
                  FontSize="11"
                  Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}"
                  Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
      </StackPanel>
     </Border>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
  </Grid>
 </Grid>
</ui:FluentWindow>
