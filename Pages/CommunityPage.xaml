<Page x:Class="UnturnedModManager.Pages.CommunityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:UnturnedModManager.Controls"
      xmlns:pages="clr-namespace:UnturnedModManager.Pages"
      Title="社区发现" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Grid Margin="28,6,28,20" PreviewMouseWheel="Page_PreviewMouseWheel">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Padding="14" Margin="0,0,0,12" CornerRadius="12" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ui:TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="搜索插件名称、作者或简介…"
                            Margin="0,0,10,0" AutomationProperties.Name="搜索社区插件"/>
                <WrapPanel x:Name="Filters" Grid.Column="1" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="DisplayName" Width="130" Margin="0,0,8,0" AutomationProperties.Name="插件分类"/>
                    <ComboBox SelectedValue="{Binding Sort}" SelectedValuePath="Tag" Width="112" Margin="0,0,8,0" AutomationProperties.Name="排序方式">
                        <ComboBoxItem Content="最新发布" Tag="newest"/><ComboBoxItem Content="下载最多" Tag="downloads"/><ComboBoxItem Content="点赞最多" Tag="likes"/>
                    </ComboBox>
                    <ui:Button Appearance="Primary" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}"/>
                </WrapPanel>
                <WrapPanel x:Name="StatusLine" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <TextBlock Text="{Binding ConnectionText}" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding ResultCount, StringFormat={}{0} 个插件}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </WrapPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ResultsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                <ItemsControl ItemsSource="{Binding Mods}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="{Binding ColumnCount, RelativeSource={RelativeSource AncestorType={x:Type pages:CommunityPage}}}"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Button Click="OpenMod_Click" Padding="0" Margin="0,0,10,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                       VerticalContentAlignment="Top" VerticalAlignment="Stretch" AutomationProperties.Name="{Binding DisplayTitle}"
                                       Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                <StackPanel>
                                    <Grid Height="124" ClipToBounds="True" Background="{DynamicResource AppCardBackgroundBrush2}">
                                        <ui:SymbolIcon Symbol="Box24" FontSize="32" Foreground="{DynamicResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image Source="{Binding CoverUrl}" Stretch="UniformToFill"/>
                                        <Border Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,3" CornerRadius="9"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                            <TextBlock Text="{Binding CategoryDisplay}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Margin="14,10,14,13">
                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="15" ToolTip="{Binding DisplayTitle}"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="{Binding DisplayDescription}" Margin="0,5,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Height="36"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Border BorderThickness="0,1,0,0" Margin="0,9,0,0" Padding="0,7,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                                            <TextBlock Text="{Binding Meta}" ToolTip="{Binding Meta}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12" Padding="24" VerticalAlignment="Top"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="BoxSearch24" FontSize="34" HorizontalAlignment="Center"/>
                    <TextBlock Text="没有找到匹配的插件" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12" Padding="24"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4"/>
                    <TextBlock Text="正在连接社区…" Margin="0,12,0,0" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="12" Padding="24"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" MaxWidth="420">
                    <controls:StatePresenter Message="{Binding ErrorMessage}" MinHeight="100"/>
                    <ui:Button Content="重新连接" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                               Command="{Binding RefreshCommand}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
