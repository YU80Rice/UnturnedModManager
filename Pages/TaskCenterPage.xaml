<Page x:Class="UnturnedModManager.Pages.TaskCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:UnturnedModManager.Controls"
      xmlns:models="clr-namespace:UnturnedModManager.Models"
      Title="任务中心"
      Background="Transparent">
    <Grid Margin="28,20,28,22" PreviewMouseWheel="Page_PreviewMouseWheel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,14">
            <ui:Button DockPanel.Dock="Right" Content="清除已完成历史"
                       Icon="{ui:SymbolIcon Delete24}"
                       Appearance="Secondary"
                       Command="{Binding ClearHistoryCommand}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            <controls:PageHeader Title="任务中心" Subtitle="追踪社区插件操作进度、SHA-256 校验阶段与失败重试。" />
        </DockPanel>

        <Border Grid.Row="1"
                Padding="14,11"
                Margin="0,0,0,14"
                CornerRadius="10"
                Background="{DynamicResource AppCardBackgroundBrush2}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <TextBlock Text="{Binding SummaryText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Border>

        <Grid Grid.Row="2">
                <ListView ItemsSource="{Binding Tasks}"
                          BorderThickness="0"
                          Background="Transparent"
                          HorizontalContentAlignment="Stretch"
                          Padding="0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18,14" Margin="0,0,0,9" CornerRadius="12"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <WrapPanel>
                                            <Border Padding="8,3" CornerRadius="6" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                                <TextBlock Text="{Binding KindText}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Stage}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="5" Margin="0,10,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <Border Background="{DynamicResource DangerSurfaceBrush}" Padding="10,7" CornerRadius="6" Margin="0,10,0,0" Visibility="{Binding HasFailureReason, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding FailureReason}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock Text="{Binding AttemptText}" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <Border HorizontalAlignment="Right" Padding="8,3" CornerRadius="10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush3}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationTaskStatus.Running}"><Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationTaskStatus.Succeeded}"><Setter Property="Background" Value="{DynamicResource AppSuccessSurfaceBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationTaskStatus.Failed}"><Setter Property="Background" Value="{DynamicResource DangerSurfaceBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationTaskStatus.Running}"><Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationTaskStatus.Succeeded}"><Setter Property="Foreground" Value="{DynamicResource AppSuccessTextBrush}"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="{x:Static models:OperationTaskStatus.Failed}"><Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Right" Margin="0,3,0,8" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:Button Content="重试" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" CommandParameter="{Binding}" Visibility="{Binding IsRetryAvailable, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Content="查看插件" Appearance="Secondary" Margin="0,8,0,0" Command="{Binding DataContext.OpenPluginCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" CommandParameter="{Binding}" Visibility="{Binding HasCommunityPlugin, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            <Border VerticalAlignment="Top" Padding="20,36" CornerRadius="12"
                    Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                    Visibility="{Binding HasTasks, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="38" HorizontalAlignment="Center" />
                    <TextBlock Text="暂无任务记录" Margin="0,12,0,0" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="从插件详情安装、更新或卸载后，进度和操作记录会出现在这里。" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
