<Page x:Class="UnturnedModManager.Pages.PluginWorkshopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:UnturnedModManager.Controls"
      Title="模组工坊"
      Background="Transparent"
      Focusable="True"
      PreviewMouseWheel="Page_PreviewMouseWheel">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: 顶部聚合导航切换栏 (进入详情时隐藏以聚焦详情内容) -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: 单一容器内容宿主 (常驻子页面实例，通过 Visibility 互斥切换) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- 1. 顶部工坊双子域切换导航栏 (Dual SubDomain Tab Bar)         -->
        <!-- ========================================================= -->
        <Grid x:Name="HeaderArea" Grid.Row="0" Margin="28,20,28,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 标题与副标题 -->
            <controls:PageHeader Grid.Column="0"
                                 Title="模组工坊"
                                 Subtitle="管理本地 BepInEx 插件方案，或发现 unmod.online 社区插件。"
                                 VerticalAlignment="Center" />

            <!-- 双子域分段式药丸切换器 -->
            <Border Grid.Column="1"
                    VerticalAlignment="Center"
                    Padding="4"
                    CornerRadius="10"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ui:Button x:Name="SubDomainLocalBtn"
                               Content="本地插件"
                               Icon="{ui:SymbolIcon Box24}"
                               Appearance="Primary"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                               Height="36"
                               Padding="14,0"
                               Margin="0,0,4,0"
                               Click="SubDomainLocalBtn_Click"
                               ToolTip="切换到本地插件" />

                    <ui:Button x:Name="SubDomainCommunityBtn"
                               Content="社区发现"
                               Icon="{ui:SymbolIcon StoreMicrosoft24}"
                               Appearance="Secondary"
                               Height="36"
                               Padding="14,0"
                               Click="SubDomainCommunityBtn_Click"
                               ToolTip="切换到社区发现" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================================= -->
        <!-- 2. 单一容器内容宿主 (Single Container Content Host)          -->
        <!-- 双视图驻留由 Visibility 互斥控制。宿主必须是 Frame：          -->
        <!-- WPF 规定 Page 只能以 Window/Frame 为父级，把 Page 直接塞进   -->
        <!-- ContentControl 会在真实布局期抛 InvalidOperationException   -->
        <!-- "Page 只能具有 Window 或 Frame 父级"（离屏测量发现不了，      -->
        <!-- 因为 ContentPresenter 直到 Loaded 才 BuildVisualTree）。     -->
        <!-- Frame 派生于 ContentControl，故代码里的 .Content 赋值不变；  -->
        <!-- 只赋 Content 不调 Navigate，因此不会产生 Journal 条目。       -->
        <!-- ========================================================= -->
        <Grid x:Name="WorkshopContentHost" Grid.Row="1">
            <!-- 子视图 1: 本地插件管理页面宿主 (默认激活) -->
            <Frame x:Name="LocalHost"
                   NavigationUIVisibility="Hidden"
                   Focusable="False"
                   Background="Transparent"
                   Visibility="Visible" />

            <!-- 子视图 2: 社区模组发现页面宿主 (默认隐藏隔离) -->
            <Frame x:Name="CommunityHost"
                   NavigationUIVisibility="Hidden"
                   Focusable="False"
                   Background="Transparent"
                   Visibility="Collapsed" />

            <!-- 详情视图宿主: 由 Slot 3 自治适配器挂载展示 (默认隐藏) -->
            <Frame x:Name="DetailHost"
                   NavigationUIVisibility="Hidden"
                   Focusable="False"
                   Background="Transparent"
                   Visibility="Collapsed" />
        </Grid>
    </Grid>
</Page>
