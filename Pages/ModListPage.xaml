<Page x:Class="UnturnedModManager.Pages.ModListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:UnturnedModManager.Controls"
      Title="本地插件"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="28"
          AllowDrop="True"
          DragOver="Page_DragOver"
          Drop="Page_Drop"
          PreviewMouseWheel="Panel_PreviewMouseWheel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:PageHeader Title="本地插件"
                             Subtitle="管理启停、卸载、插件方案和社区更新；点击已匹配的条目可打开社区详情。"
                             Margin="0,0,0,16" />

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="刷新并同步"
                           Icon="{ui:SymbolIcon ArrowSync24}"
                           Appearance="Primary"
                           Command="{Binding RefreshCommand}" />
                <ui:Button Content="打开插件文件夹"
                           Icon="{ui:SymbolIcon FolderOpen24}"
                           Margin="10,0,0,0"
                           Command="{Binding OpenFolderCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding CountText}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <Border Grid.Row="2"
                Padding="16"
                Margin="0,0,0,12"
                CornerRadius="10"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="插件方案"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="保存一套已安装插件的启停状态。例如“联机优化（ABC）”与“开发调试（XYZ）”。切换只改名 .dll/.disabled，不复制或删除插件文件。"
                           Margin="0,4,0,12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <WrapPanel>
                    <ComboBox Width="260"
                              MinWidth="180"
                              Margin="0,0,8,8"
                              ItemsSource="{Binding PluginProfiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberPath="Name"
                              ToolTip="选择要应用或保存的插件方案" />
                    <ui:Button Content="应用方案"
                               Icon="{ui:SymbolIcon CheckmarkCircle24}"
                               Appearance="Primary"
                               Margin="0,0,8,8"
                               Command="{Binding ApplyProfileCommand}" />
                    <ui:Button Content="保存当前状态"
                               Icon="{ui:SymbolIcon Save24}"
                               Margin="0,0,8,8"
                               Command="{Binding SaveProfileCommand}" />
                    <ui:Button Content="删除方案"
                               Icon="{ui:SymbolIcon Delete24}"
                               Margin="0,0,8,8"
                               Command="{Binding DeleteProfileCommand}" />
                </WrapPanel>
                <WrapPanel Margin="0,2,0,0">
                    <ui:TextBox Width="260"
                                MinWidth="180"
                                Margin="0,0,8,8"
                                PlaceholderText="新方案名称，例如：联机优化"
                                Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Content="从当前状态创建"
                               Icon="{ui:SymbolIcon Add24}"
                               Margin="0,0,8,8"
                               Command="{Binding CreateProfileCommand}" />
                </WrapPanel>
                <TextBlock Text="{Binding ProfileStatusText}"
                           Margin="0,2,0,0"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3"
                CornerRadius="10"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <ListView ItemsSource="{Binding Mods}"
                          BorderThickness="0"
                          Background="Transparent"
                          HorizontalContentAlignment="Stretch"
                          PreviewMouseLeftButtonUp="ModsList_PreviewMouseLeftButtonUp"
                          PreviewKeyDown="ModsList_PreviewKeyDown"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="16,12"
                                    Tag="{Binding}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayTitle}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Margin="10,0,0,0"
                                                    Padding="7,2"
                                                    CornerRadius="7"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding SourceText}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding FileName}"
                                                   Margin="0,3,0,0"
                                                   FontSize="12"
                                                   ToolTip="{Binding RelativePath}"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding VersionText}"
                                                   Margin="0,2,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button Content="更新"
                                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                                   Appearance="Primary"
                                                   Margin="0,0,8,0"
                                                   Command="{Binding DataContext.UpdateCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Content="社区详情"
                                                   Margin="0,0,8,0"
                                                   Command="{Binding DataContext.OpenCommunityCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                   CommandParameter="{Binding}"
                                                   Visibility="{Binding IsCommunityMatched, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Content="卸载"
                                                   Icon="{ui:SymbolIcon Delete24}"
                                                   Appearance="Secondary"
                                                   Margin="0,0,10,0"
                                                   Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                   CommandParameter="{Binding}" />
                                        <ui:ToggleSwitch IsChecked="{Binding IsEnabled}"
                                                         Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                         CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Symbol="Box24" FontSize="38" HorizontalAlignment="Center" />
                    <TextBlock Text="暂无插件，可将 .dll 文件拖入此页面安装。"
                               Margin="0,12,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                        <TextBlock Text="正在读取本地插件并同步社区信息…" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
