<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>2.1.8</Version>
    <AssemblyVersion>2.1.8.0</AssemblyVersion>
    <FileVersion>2.1.8.0</FileVersion>
    <Authors>YU80Rice and contributors</Authors>
    <Description>Unturned 启动、BepInEx 插件管理与 unmod.online 社区客户端。</Description>
    <Copyright>Copyright (C) 2026 YU80Rice</Copyright>
    <PackageLicenseExpression>GPL-2.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/YU80Rice/UnturnedModManager</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="UnturnedModManager.Tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\umm-mascot-chibi-v2.png" />
  </ItemGroup>

</Project>
