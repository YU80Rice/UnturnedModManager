<ui:FluentWindow x:Class="UnturnedModManager.OnboardingWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                  xmlns:controls="clr-namespace:UnturnedModManager.Controls"
                  Background="{DynamicResource ApplicationBackgroundBrush}"
                  Title="Unturned Mod Manager · 首次设置"
                  Width="660"
                  Height="540"
                  MinWidth="550"
                  MinHeight="460"
                  ResizeMode="CanResize"
                  WindowStartupLocation="CenterScreen"
                  WindowBackdropType="None">
    <ui:FluentWindow.Resources>
        <Style x:Key="ThemeModeSegment" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Segment" Padding="{TemplateBinding Padding}" CornerRadius="12"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource AppCardBackgroundBrush2}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Segment" Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="0,3,0,13" Margin="0,0,0,14" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <TextBlock Text="欢迎使用 Unturned Mod Manager" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border Padding="8,3" CornerRadius="11" Background="{DynamicResource AppAccentSoftBrush}" BorderBrush="{DynamicResource AppAccentBorderBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding StepText}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </Border>
            </WrapPanel>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <StackPanel Visibility="{Binding IsWelcomeStep, Converter={StaticResource BoolToVisibility}}">
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="1 · 选择游戏目录"
                                   FontSize="19"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="UMM 需要知道 Unturned.exe 所在的目录，才能管理插件环境和启动游戏。你也可以先跳过，稍后在设置中配置。"
                                   Margin="0,8,0,18"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="例如：E:\Steam\steamapps\common\Unturned" />
                            <ui:Button Grid.Column="1"
                                       Content="浏览…"
                                       Margin="10,0,0,0"
                                       Command="{Binding BrowseCommand}" />
                            <ui:Button Grid.Column="2"
                                       Content="自动寻找"
                                       Icon="{ui:SymbolIcon Search16}"
                                       Margin="6,0,0,0"
                                       Command="{Binding DetectCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding Message}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsThemeStep, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="2 · 选择明暗模式和强调色" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="拖动圆环选择强调色，点击中心展开完整色彩调节。" Margin="0,5,0,9" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Border HorizontalAlignment="Left" CornerRadius="15" Padding="3"
                        Background="{DynamicResource AppPillBackgroundBrush}" BorderBrush="{DynamicResource AppPillBorderBrush}" BorderThickness="1"
                        AutomationProperties.Name="明暗模式">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource ThemeModeSegment}" GroupName="OnboardingThemeMode" Content="浅色"
                                     IsChecked="{Binding IsLightSelected, Mode=OneWay}" Command="{Binding ChangeThemeCommand}" CommandParameter="Light" />
                        <RadioButton Style="{StaticResource ThemeModeSegment}" GroupName="OnboardingThemeMode" Content="深色"
                                     IsChecked="{Binding IsDarkSelected, Mode=OneWay}" Command="{Binding ChangeThemeCommand}" CommandParameter="Dark" />
                        <RadioButton Style="{StaticResource ThemeModeSegment}" GroupName="OnboardingThemeMode" Content="跟随系统"
                                     IsChecked="{Binding IsSystemSelected, Mode=OneWay}" Command="{Binding ChangeThemeCommand}" CommandParameter="System" />
                    </StackPanel>
                </Border>
                <Border Margin="0,10,0,8" Padding="12" CornerRadius="10" Background="{DynamicResource AppCardBackgroundBrush2}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <controls:ColorWheelControl RingSize="176" AccentColor="{Binding AccentColor, Mode=TwoWay}" SurfaceTint="{Binding SurfaceTint, Mode=TwoWay}" IsDarkTheme="{Binding IsDarkTheme}" />
                </Border>
            </StackPanel>

            <StackPanel Visibility="{Binding IsFinishStep, Converter={StaticResource BoolToVisibility}}"
                        VerticalAlignment="Center">
                <Border Style="{StaticResource SurfaceCardStyle}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="3 · 设置完成"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="进入启动页后可检查 BepInEx 环境；在模组工坊管理本地插件或浏览社区。社区账户可以稍后登录。"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   LineHeight="23"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <ui:Button Content="稍后设置"
                       Appearance="Secondary"
                       HorizontalAlignment="Left"
                       Command="{Binding SkipCommand}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="上一步"
                           Margin="0,0,8,0"
                           Command="{Binding BackCommand}" />
                <ui:Button Content="下一步"
                           Appearance="Primary"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                           Command="{Binding NextCommand}"
                           Visibility="{Binding IsFinishStep, Converter={StaticResource InverseBoolToVisibility}}" />
                <ui:Button Content="开始使用"
                           Appearance="Primary"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                           Command="{Binding FinishCommand}"
                           Visibility="{Binding IsFinishStep, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
