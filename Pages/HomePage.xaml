<Page x:Class="UnturnedModManager.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="游戏启动"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <ScrollViewer x:Name="RootScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <StackPanel Margin="30,22,30,42" MaxWidth="1040" HorizontalAlignment="Center">
            <Border CornerRadius="10" Padding="14" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                    BorderThickness="0,3,0,0"
                    Visibility="{Binding HasCrashAlert, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="检测到上次游戏异常退出" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="可以一键导出 Unity 与 BepInEx 日志，便于排查插件或运行环境问题。"
                                   Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <ui:Button Content="导出诊断日志" Icon="{ui:SymbolIcon FolderArrowRight24}"
                                   Appearance="Primary" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Command="{Binding ExportLogsCommand}" />
                        <ui:Button Content="忽略" Margin="8,0,0,0" Command="{Binding IgnoreCrashCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,22">
                <StackPanel>
                    <TextBlock Text="游戏启动" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="管理运行环境、性能优化并安全启动 Unturned"
                               Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,6" CornerRadius="12"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#20B468" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                            <Setter Property="Fill" Value="#F0A020" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding LaunchButtonText}" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border CornerRadius="16"
                    Margin="0,0,0,16"
                    Padding="24,20,18,18"
                    ClipToBounds="True"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                    Visibility="{Binding IsHomeWelcomeEnabled, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="230" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="340" Height="340"
                             HorizontalAlignment="Right" VerticalAlignment="Center"
                             Margin="0,0,-74,0"
                             Fill="{DynamicResource AccentFillColorDefaultBrush}"
                             Opacity="0.10"
                             IsHitTestVisible="False" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Padding="8,3"
                                    CornerRadius="8"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="UMM 欢迎区" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="{Binding WelcomeGreeting}"
                                       Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="让插件管理更轻松一点"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Margin="0,12,0,0" />
                        <TextBlock Text="这里会在 UMM 升级后自动展示当前版本的更新摘要；联网时会同步官方 GitHub Release 的要点。你可以在设置中随时重新开启或关闭这个欢迎区。"
                                   Margin="0,5,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Border Margin="0,15,0,0"
                                Padding="13,11"
                                CornerRadius="10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                Visibility="{Binding HasHomeAnnouncement, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding HomeAnnouncementTitle}" FontWeight="SemiBold" />
                                    <Border Margin="8,0,0,0"
                                            Padding="6,2"
                                            CornerRadius="6"
                                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="{Binding HomeAnnouncementVersion}" Foreground="White" FontSize="10" />
                                    </Border>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding HomeAnnouncementHighlights}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Ellipse Width="5" Height="5"
                                                         VerticalAlignment="Center"
                                                         Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                    <ui:Button Content="{Binding UpdateDownloadButtonText}"
                                               Appearance="Primary"
                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                               Visibility="{Binding HasAvailableLauncherUpdate, Converter={StaticResource BoolToVisibility}}"
                                               Command="{Binding DownloadLauncherUpdateCommand}" />
                                    <ui:Button Content="查看完整更新日志"
                                               Margin="8,0,0,0"
                                               Appearance="Secondary"
                                               Command="{Binding OpenReleaseNotesCommand}" />
                                    <ui:Button Content="本次不再提示"
                                               Margin="8,0,0,0"
                                               Appearance="Secondary"
                                               Command="{Binding AcknowledgeAnnouncementCommand}" />
                                </StackPanel>
                                <StackPanel Margin="0,9,0,0"
                                            Visibility="{Binding HasAvailableLauncherUpdate, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding LauncherUpdateDetail}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ProgressBar Height="4"
                                                 Margin="0,7,0,0"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding LauncherUpdatePercentage, Mode=OneWay}"
                                                 Visibility="{Binding IsDownloadingLauncherUpdate, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding LauncherUpdateText}"
                                               Margin="0,5,0,0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding IsDownloadingLauncherUpdate, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ui:Button Content="关闭首页欢迎区"
                                   Margin="0,12,0,0"
                                   HorizontalAlignment="Left"
                                   Appearance="Secondary"
                                   Command="{Binding HideHomeWelcomeCommand}" />
                    </StackPanel>
                    <Image Grid.Column="1"
                           Source="/Assets/umm-mascot-chibi-v2.png"
                           Stretch="Uniform"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           MaxHeight="255"
                           Margin="8,0,-4,-24"
                           IsHitTestVisible="False" />
                </Grid>
            </Border>

            <Border CornerRadius="12" Padding="20" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse Width="12" Height="12" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBepInExInstalled}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding BepInExTitle}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BepInExDetail}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <ui:Button Content="一键安装" Icon="{ui:SymbolIcon ArrowDownload24}" Appearance="Primary" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                   Command="{Binding InstallCommand}"
                                   Visibility="{Binding CanInstallBepInEx, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="{Binding BepInExRepairButtonText}" Icon="{ui:SymbolIcon Wrench24}"
                                   Command="{Binding RepairCommand}"
                                   Visibility="{Binding IsBepInExInstalled, Converter={StaticResource BoolToVisibility}}" />
                        <ui:Button Content="卸载环境" Icon="{ui:SymbolIcon Delete24}"
                                   Margin="8,0,0,0"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Command="{Binding UninstallCommand}"
                                   Visibility="{Binding IsBepInExInstalled, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" CornerRadius="12" Padding="20"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="PlugDisconnected24" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="全局模组环境" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="启用 BepInEx 插件加载；关闭后以纯净模式运行。"
                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding GlobalModsEnabled}"
                                         Command="{Binding ToggleGlobalModsCommand}" Margin="12,0,0,0" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" CornerRadius="12" Padding="20"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="TopSpeed24" FontSize="22" Margin="0,0,12,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="DXVK 渲染测试" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="将 DX11 转换为 Vulkan；适用性取决于显卡、驱动和游戏版本。"
                                       Margin="0,3,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="2" IsChecked="{Binding DxvkEnabled}"
                                         Command="{Binding ToggleDxvkCommand}" Margin="12,0,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <Border CornerRadius="12" Padding="16" Margin="0,0,0,20"
                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                    Visibility="{Binding HasGpuInfo, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Desktop24" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding GpuName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding GpuRecommendation}" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border CornerRadius="12" Padding="18" Margin="0,0,0,20"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="DocumentError24" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DiagnosticTitle}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding DiagnosticSummary}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding DiagnosticDetail}" Margin="0,10,0,0" TextWrapping="Wrap"
                                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                                   Visibility="{Binding HasDiagnosticDetail, Converter={StaticResource BoolToVisibility}}"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <ui:Button Content="分析最近日志" Icon="{ui:SymbolIcon Search24}"
                                   Command="{Binding AnalyzeLogsCommand}" />
                        <ui:Button Content="导出诊断包" Icon="{ui:SymbolIcon FolderArrowRight24}"
                                   Margin="8,0,0,0" Command="{Binding ExportLogsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border CornerRadius="12" Padding="22" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel HorizontalAlignment="Center">
                    <ui:Button Appearance="Primary" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Height="56" MinWidth="300"
                               FontSize="18" FontWeight="SemiBold"
                               Command="{Binding LaunchCommand}" IsEnabled="{Binding CanLaunch}">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Play24" FontSize="20" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding LaunchButtonText}" VerticalAlignment="Center" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                    </ui:Button>
                    <StackPanel Width="420" Margin="0,18,0,0"
                                Visibility="{Binding HasOperationProgress, Converter={StaticResource BoolToVisibility}}">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding OperationPercentage, Mode=OneWay}"
                                     IsIndeterminate="False" Height="7" />
                        <TextBlock Text="{Binding OperationText}" Margin="0,8,0,0" TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ui:Button Content="取消当前操作" Command="{Binding CancelOperationCommand}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
