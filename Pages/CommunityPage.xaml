<Page x:Class="UnturnedModManager.Pages.CommunityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:UnturnedModManager.Controls"
      Title="插件社区" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="28,22,28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <controls:PageHeader Title="插件社区" Subtitle="发现并安装 unmod.online 社区插件 · 自动处理依赖 · 安装可追踪、可卸载"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,6" CornerRadius="12" Background="{DynamicResource ControlFillColorSecondaryBrush}"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#20B468" Margin="0,0,7,0"/><TextBlock Text="{Binding ConnectionText}" FontSize="12"/></StackPanel></Border>
        </Grid>
        <Border Grid.Row="1" Padding="14" Margin="0,0,0,14" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Grid.Column="0" PlaceholderText="搜索插件名称、作者或简介…" Margin="0,0,10,0"/>
                <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="DisplayName" Grid.Column="1" Margin="0,0,10,0"/>
                <ComboBox SelectedValue="{Binding Sort}" SelectedValuePath="Tag" Grid.Column="2" Margin="0,0,10,0"><ComboBoxItem Content="最新发布" Tag="newest"/><ComboBoxItem Content="下载最多" Tag="downloads"/><ComboBoxItem Content="点赞最多" Tag="likes"/></ComboBox>
                <ui:Button Grid.Column="3" Appearance="Primary" Content="刷新" Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="16,13"><TextBlock Text="社区内容" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="{Binding ResultCount, StringFormat={}{0} 个插件}" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></Grid>
                <ListBox ItemsSource="{Binding Mods}" Grid.Row="1" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch" SelectionChanged="ModsList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><Border Padding="14,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="78"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}"><Image Source="{Binding CoverUrl}" Stretch="UniformToFill"/></Border>
                        <Grid Grid.Column="1" Margin="14,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/><Border HorizontalAlignment="Right" Padding="7,2" CornerRadius="7" Background="{DynamicResource ControlFillColorSecondaryBrush}"><TextBlock Text="{Binding CategoryDisplay}" FontSize="11"/></Border>
                            <TextBlock Grid.Row="1" Text="{Binding DisplayDescription}" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxHeight="38"/><TextBlock Grid.Row="2" Text="{Binding Meta}" Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </Grid></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}"><ui:SymbolIcon Symbol="BoxSearch24" FontSize="38" HorizontalAlignment="Center"/><TextBlock Text="没有找到匹配的插件" Margin="0,12,0,0"/></StackPanel>
                <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"><ProgressBar IsIndeterminate="True" Width="180" Height="4"/><TextBlock Text="正在连接社区…" Margin="0,12,0,0"/></StackPanel>
                <Border Grid.RowSpan="2" Background="{DynamicResource ControlFillColorDefaultBrush}" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <controls:StatePresenter Message="{Binding ErrorMessage}" Width="420" MinHeight="100"/>
                        <ui:Button Content="重新连接" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Command="{Binding RefreshCommand}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
