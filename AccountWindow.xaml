<Window x:Class="UnturnedModManager.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="社区账户"
        Width="480" Height="430"
        MinWidth="440" MinHeight="390"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="24">
        <Border Padding="28" CornerRadius="12" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel HorizontalAlignment="Center">
                    <Border Width="76" Height="76" CornerRadius="38"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="{Binding AvatarFallback}" FontSize="28"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvatar}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Username}" FontSize="22" FontWeight="SemiBold"
                               Margin="0,14,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding AccountHint}" Margin="0,6,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <ui:Button Content="在浏览器中登录"
                               Icon="{ui:SymbolIcon Open24}"
                               Appearance="Primary"
                               HorizontalAlignment="Stretch"
                               Padding="12"
                               Command="{Binding LoginCommand}"
                               Visibility="{Binding CanLogin, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="取消登录等待"
                               Appearance="Secondary"
                               HorizontalAlignment="Stretch"
                               Padding="12"
                               Command="{Binding CancelCommand}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="浏览器会打开 unmod.online；请在那里完成人机验证。启动器只接收本机回调，并会加密保存登录凭据。"
                               Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
                    <ui:Button Content="刷新资料" Appearance="Secondary" Command="{Binding RefreshCommand}" />
                    <ui:Button Content="退出登录" Appearance="Secondary" Margin="10,0,0,0"
                               Command="{Binding LogoutCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
