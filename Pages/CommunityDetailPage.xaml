<Page x:Class="UnturnedModManager.Pages.CommunityDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:UnturnedModManager.Controls"
      Background="{DynamicResource ApplicationBackgroundBrush}"
      PreviewKeyDown="Page_PreviewKeyDown"
      PreviewMouseWheel="Page_PreviewMouseWheel"
      Focusable="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
        <Grid Margin="32,20,32,40">
            <StackPanel>
                <ui:Button x:Name="BackButton"
                           Content="返回"
                           Icon="{ui:SymbolIcon ArrowLeft24}"
                           Appearance="Secondary"
                           HorizontalAlignment="Left"
                           MinHeight="40"
                           Padding="14,6"
                           Click="BackButton_Click"
                           ToolTip="返回上一级（Esc）" />

                <ui:InfoBar x:Name="StatusInfoBar" IsOpen="False" Margin="0,14,0,0" />

                <Border Margin="0,16,0,0"
                        Padding="20"
                        CornerRadius="12"
                        Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <StackPanel>
                        <Image Source="{Binding CoverUrl}"
                               Height="260"
                               Stretch="UniformToFill"
                               Margin="0,0,0,20"
                               Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding Title}"
                                   FontSize="30"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Meta}"
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <Border Margin="0,16,0,0"
                                Padding="12"
                                CornerRadius="8"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock Text="依赖"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding DependencyItems}"
                                              Visibility="{Binding HasDependencies, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:Button Content="{Binding DisplayTitle}"
                                                       HorizontalContentAlignment="Left"
                                                       Appearance="Secondary"
                                                       Margin="0,0,0,6"
                                                       Command="{Binding DataContext.OpenDependencyCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                       CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="无额外依赖"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding HasDependencies, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,18,0,0">
                            <ProgressBar IsIndeterminate="True" Height="4" />
                            <TextBlock Text="正在加载插件详情…" Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                                    Margin="0,18,0,0">
                            <TextBlock Text="{Binding ErrorMessage}"
                                       Foreground="#E74C3C"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ui:Button Content="重新加载"
                                           Appearance="Primary"
                                           Icon="{ui:SymbolIcon ArrowSync24}"
                                           Command="{Binding RetryCommand}" />
                                <ui:Button x:Name="ErrorBackButton"
                                           Content="返回上一级"
                                           Click="BackButton_Click"
                                           Margin="10,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Separator Margin="0,20" />
                        <TextBlock Text="简介" FontWeight="SemiBold" FontSize="17" />
                        <controls:MarkdownTextBlock Markdown="{Binding Body}"
                                                     Margin="0,10,0,0"
                                                     TextWrapping="Wrap"
                                                     FontSize="14"
                                                     LineHeight="23"
                                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <ui:Button Content="登录社区账户后安装"
                                       Icon="{ui:SymbolIcon Person24}"
                                       Appearance="Primary"
                                       Command="{Binding SignInCommand}"
                                       Visibility="{Binding RequiresLogin, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Content="安装到当前游戏"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Appearance="Primary"
                                       Command="{Binding InstallCommand}"
                                       IsEnabled="{Binding CanInstall}"
                                       Margin="10,0,0,0" />
                            <ui:Button Content="更新到社区版本"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Appearance="Primary"
                                       Margin="10,0,0,0"
                                       Command="{Binding UpdateCommand}"
                                       Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVisibility}}" />
                            <ui:Button Content="卸载插件"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Appearance="Secondary"
                                       Margin="10,0,0,0"
                                       Command="{Binding UninstallCommand}"
                                       Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="安装和更新使用真实游戏目录；覆盖旧文件前会备份，卸载前会校验文件是否被修改。"
                                   Margin="0,14,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
