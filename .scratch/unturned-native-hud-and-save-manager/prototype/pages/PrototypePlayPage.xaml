<Page x:Class="UnturnedModManager.Prototypes.PrototypePlayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PrototypePlayPage"
      Background="Transparent">

    <ScrollViewer x:Name="PlayRootScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="0,0,16,24">

            <!-- 1. 关键状态横幅 (Critical Status Banner) - 联动模组/原版状态 -->
            <Border x:Name="StatusBanner"
                    Margin="0,0,0,16"
                    CornerRadius="6"
                    Padding="14,10"
                    Background="#D015241B"
                    BorderBrush="#FF38A169"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusBannerIcon" Grid.Column="0" Text="🛡️" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="12">
                        <Run x:Name="StatusBannerTitle" Text="运行状态就绪：" FontWeight="Bold" />
                        <Run x:Name="StatusBannerDesc" Text="已开启纯净模组环境 (winhttp / -NoBattlEye)，无崩溃与冲突。" Foreground="#FFCBD5E0" />
                    </TextBlock>
                    <TextBlock x:Name="StatusBannerTag" Grid.Column="2" Text="BE 5.4.23.5" Foreground="#FF38A169" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 2. 主启动舞台与环境诊断区 (Main Launch Stage & Environment Diagnostics) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：英雄启动卡片 (Hero Launch Card) - 联动 BepInEx/DXVK 状态 -->
                <Border x:Name="LaunchHeroCard"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        Style="{DynamicResource UnturnedHudCardStyle}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Unturned Mod Manager"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFFFF"
                                   Margin="0,0,0,4" />
                        <TextBlock x:Name="HeroSubtitleText"
                                   Text="模组就绪 · 将加载 12 个本地插件与 BUE"
                                   FontSize="12"
                                   Foreground="#FFCBD5E0"
                                   Margin="0,0,0,12" />

                        <!-- 当前激活 Profile 药丸 -->
                        <Border Background="#40000000"
                                BorderBrush="{DynamicResource UnturnedStrokeSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,6"
                                Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="当前配置方案: " FontSize="11" Foreground="#FFCBD5E0" VerticalAlignment="Center" />
                                <TextBlock x:Name="ProfileTitleText" Text="默认联机优化 (12 Mods)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource UnturnedAccentGoldBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- 大号原生风格启动按钮 (Hero Play Button) -->
                        <Button x:Name="HeroLaunchBtn"
                                Height="52"
                                Background="#D8236B3D"
                                BorderBrush="#FF38A169"
                                BorderThickness="2"
                                CornerRadius="8"
                                Cursor="Hand"
                                Click="HeroLaunchBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock x:Name="HeroLaunchBtnIcon" Text="▶" FontSize="18" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock x:Name="HeroLaunchBtnText" Text="启动游戏 (模组模式)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                                <TextBlock x:Name="HeroLaunchTagText" Text="" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource UnturnedAccentGoldBrush}" VerticalAlignment="Center" Margin="6,0,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="游戏路径: E:\Steam\steamapps\common\Unturned"
                                   FontSize="11"
                                   Foreground="#FF718096"
                                   Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 右侧：环境与诊断卡片 (Environment & Diagnostics Card) -->
                <Border x:Name="EnvDiagnosticsCard"
                        Grid.Column="1"
                        Style="{DynamicResource UnturnedHudCardStyle}">
                    <StackPanel VerticalAlignment="Top">
                        <!-- 卡片标题 -->
                        <Grid Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔧" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="环境与诊断"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFFFF"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- BepInEx 模块：状态 + 开关 + 检查修复 -->
                        <Border Background="#30000000"
                                BorderBrush="{DynamicResource UnturnedStrokeSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse x:Name="BepInExStateDot" Width="6" Height="6" Fill="#FF38A169" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="BepInExStateText"
                                                   Text="BepInEx 5.4.23.5 (x64) 运行就绪"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFFFFFF"
                                                   FontSize="11" />
                                    </StackPanel>
                                    <Button x:Name="RepairBepInExBtn"
                                            HorizontalAlignment="Right"
                                            Background="#502D3748"
                                            BorderBrush="#FF4A5568"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="8,3"
                                            FontSize="10"
                                            Foreground="{DynamicResource UnturnedAccentGoldBrush}"
                                            Cursor="Hand"
                                            Click="RepairBepInExBtn_Click">
                                        <TextBlock Text="🔧 检查并修复" />
                                    </Button>
                                </Grid>
                                <CheckBox Grid.Row="1"
                                          x:Name="BepInExToggle"
                                          IsChecked="True"
                                          Margin="0,6,0,0"
                                          Cursor="Hand"
                                          Checked="BepInExToggle_Checked"
                                          Unchecked="BepInExToggle_Unchecked">
                                    <TextBlock Text="启用 BepInEx 模组加载器 (winhttp.dll)"
                                               Foreground="#FFCBD5E0"
                                               FontSize="11" />
                                </CheckBox>
                            </Grid>
                        </Border>

                        <!-- DXVK 模块：开关 + 显卡 Vulkan 适配性提示 -->
                        <Border Background="#30000000"
                                BorderBrush="{DynamicResource UnturnedStrokeSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="DxvkToggle"
                                          IsChecked="False"
                                          Cursor="Hand"
                                          Checked="DxvkToggle_Checked"
                                          Unchecked="DxvkToggle_Unchecked">
                                    <TextBlock Text="启用 DXVK (DirectX 转 Vulkan 渲染提升帧率)"
                                               Foreground="#FFCBD5E0"
                                               FontSize="11" />
                                </CheckBox>
                                <TextBlock x:Name="DxvkGpuHintText"
                                           Text="ℹ️ 检测到 NVIDIA GeForce RTX 4070 (支持 Vulkan 1.3，可按需开启提升帧率稳定性)"
                                           FontSize="10"
                                           Foreground="{DynamicResource UnturnedAccentGoldBrush}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!-- 诊断与排障模块：异常摘要 + 导出脱敏诊断包 -->
                        <Border Background="#30000000"
                                BorderBrush="{DynamicResource UnturnedStrokeSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="当前环境诊断摘要" FontSize="10" Foreground="#FF718096" />
                                    <TextBlock x:Name="DiagnosticSummaryText"
                                               Text="未捕获运行异常与模组冲突，日志健康"
                                               FontSize="11"
                                               Foreground="#FFCBD5E0"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        x:Name="ExportDiagnosticsBtn"
                                        Background="#502D3748"
                                        BorderBrush="#FF4A5568"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="10,4"
                                        FontSize="10"
                                        Foreground="#FFFFFFFF"
                                        Cursor="Hand"
                                        Click="ExportDiagnosticsBtn_Click">
                                    <TextBlock Text="📦 导出脱敏诊断包" />
                                </Button>
                            </Grid>
                        </Border>

                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. 下半区：精选插件与版本要点 (Featured Plugins & Patch Notes) -->
            <Grid x:Name="FeaturedGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 精选插件 / 社区推荐 (Featured Plugins Card) -->
                <Border Grid.Column="0"
                        Margin="0,0,12,0"
                        Style="{DynamicResource UnturnedHudCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="精选插件 / 社区推荐"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF" />
                            <TextBlock Text="社区认证 BepInEx 插件"
                                       HorizontalAlignment="Right"
                                       FontSize="10"
                                       Foreground="#FF38A169"
                                       FontWeight="Bold" />
                        </Grid>
                        <Border Height="72" CornerRadius="6" Background="#30000000" Padding="12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BetterUnturnedExperience (BUE)" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" />
                                <TextBlock Text="现代化游戏体验与交互优化组件，独立运行于游戏客户端内。" FontSize="11" Foreground="#FFCBD5E0" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 更新公告 (Patch Notes Card) - 吉祥物挂件位于更新公告栏右下角 -->
                <Border Grid.Column="1"
                        Style="{DynamicResource UnturnedHudCardStyle}">
                    <Grid>
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="v2.2.1 Patch Notes"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#FFFFFFFF"
                                           VerticalAlignment="Center" />
                                <!-- 吉祥物显隐控制按钮 (位于更新公告栏头部右侧) -->
                                <Button x:Name="MascotToggleBtn"
                                        HorizontalAlignment="Right"
                                        Background="#301A2026"
                                        BorderBrush="#FF4A5568"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8,3"
                                        Content="🦊 挂件"
                                        Foreground="#FFCBD5E0"
                                        FontSize="10"
                                        Cursor="Hand"
                                        Click="MascotToggleBtn_Click" />
                            </Grid>
                            <TextBlock Text="• 新增玩家自定义全屏壁纸与毛玻璃模糊。" FontSize="11" Foreground="#FFCBD5E0" Margin="0,0,0,4" />
                            <TextBlock Text="• 接入 PreviewMouseWheel 隧道路由，修复滚轮卡滞。" FontSize="11" Foreground="#FFCBD5E0" Margin="0,0,0,4" />
                            <TextBlock Text="• 补齐首页环境与诊断卡片，打通启动前状态联动闭环。" FontSize="11" Foreground="{DynamicResource UnturnedAccentGoldBrush}" />
                        </StackPanel>

                        <!-- 吉祥物挂件 (位于更新公告栏右下角，支持平滑折叠) -->
                        <Border x:Name="MascotContainer"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,0,-4,-12"
                                Width="54"
                                Height="54"
                                IsHitTestVisible="False"
                                Visibility="Visible">
                            <TextBlock Text="🦊" FontSize="38" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
