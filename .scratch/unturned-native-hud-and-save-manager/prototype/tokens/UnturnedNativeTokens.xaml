<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================= -->
    <!-- Unturned Native HUD Design Tokens (Ticket 02 Prototype)           -->
    <!-- 依据 Unturned 原版主菜单提取的视觉代币体系，符合 WCAG 2.1 AA 规范  -->
    <!-- ================================================================= -->

    <!-- 1. 颜色代币 (Color Tokens) -->
    <!-- 基础背景与面板：暗调半透明军工质感 -->
    <Color x:Key="UnturnedBackdropColor">#FF0F1418</Color>
    <SolidColorBrush x:Key="UnturnedBackdropBrush" Color="{StaticResource UnturnedBackdropColor}" />

    <Color x:Key="UnturnedHudPanelColor">#D814191F</Color>
    <SolidColorBrush x:Key="UnturnedHudPanelBrush" Color="{StaticResource UnturnedHudPanelColor}" />

    <Color x:Key="UnturnedHudCardColor">#B81A2027</Color>
    <SolidColorBrush x:Key="UnturnedHudCardBrush" Color="{StaticResource UnturnedHudCardColor}" />

    <!-- 边框与轮廓代币 -->
    <Color x:Key="UnturnedStrokeSubtleColor">#2A3441</Color>
    <SolidColorBrush x:Key="UnturnedStrokeSubtleBrush" Color="{StaticResource UnturnedStrokeSubtleColor}" />

    <Color x:Key="UnturnedStrokeStrongColor">#4A5568</Color>
    <SolidColorBrush x:Key="UnturnedStrokeStrongBrush" Color="{StaticResource UnturnedStrokeStrongColor}" />

    <!-- 前景与文字代币 (严格保证对比度 > 4.5:1) -->
    <!-- 白色文字在 #14191F 底色上对比度为 15.6:1 (远超 AAA 7.0:1) -->
    <Color x:Key="UnturnedTextPrimaryColor">#FFFFFFFF</Color>
    <SolidColorBrush x:Key="UnturnedTextPrimaryBrush" Color="{StaticResource UnturnedTextPrimaryColor}" />

    <!-- 次级淡灰文字在 #14191F 底色上对比度为 8.2:1 (超 AA 4.5:1) -->
    <Color x:Key="UnturnedTextSecondaryColor">#FFCBD5E0</Color>
    <SolidColorBrush x:Key="UnturnedTextSecondaryBrush" Color="{StaticResource UnturnedTextSecondaryColor}" />

    <!-- Unturned 原版标志性金黄与战术绿 -->
    <Color x:Key="UnturnedAccentGoldColor">#FFE2B024</Color>
    <SolidColorBrush x:Key="UnturnedAccentGoldBrush" Color="{StaticResource UnturnedAccentGoldColor}" />

    <Color x:Key="UnturnedAccentGreenColor">#FF38A169</Color>
    <SolidColorBrush x:Key="UnturnedAccentGreenBrush" Color="{StaticResource UnturnedAccentGreenColor}" />

    <Color x:Key="UnturnedAccentRedColor">#FFE53E3E</Color>
    <SolidColorBrush x:Key="UnturnedAccentRedBrush" Color="{StaticResource UnturnedAccentRedColor}" />

    <!-- 药丸按钮状态颜色 -->
    <Color x:Key="UnturnedPillNormalColor">#781A2128</Color>
    <SolidColorBrush x:Key="UnturnedPillNormalBrush" Color="{StaticResource UnturnedPillNormalColor}" />

    <Color x:Key="UnturnedPillHoverColor">#A828333E</Color>
    <SolidColorBrush x:Key="UnturnedPillHoverBrush" Color="{StaticResource UnturnedPillHoverColor}" />

    <Color x:Key="UnturnedPillPressedColor">#E010151A</Color>
    <SolidColorBrush x:Key="UnturnedPillPressedBrush" Color="{StaticResource UnturnedPillPressedColor}" />

    <Color x:Key="UnturnedPillSelectedColor">#C8202933</Color>
    <SolidColorBrush x:Key="UnturnedPillSelectedBrush" Color="{StaticResource UnturnedPillSelectedColor}" />

    <!-- 2. 度量与圆角代币 (Dimension & Geometry Tokens) -->
    <CornerRadius x:Key="UnturnedPillCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="UnturnedCardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="UnturnedStatusBadgeCornerRadius">14</CornerRadius>
    <Thickness x:Key="UnturnedPillPadding">18,10</Thickness>
    <Thickness x:Key="UnturnedCardPadding">16</Thickness>

    <!-- 3. 字体代币 (Typography Tokens) -->
    <FontFamily x:Key="UnturnedTitleFontFamily">Cascadia Mono, Consolas, Segoe UI Variable Display, Microsoft YaHei, sans-serif</FontFamily>
    <FontFamily x:Key="UnturnedBodyFontFamily">Segoe UI Variable Display, Microsoft YaHei, sans-serif</FontFamily>
    <FontFamily x:Key="UnturnedCodeFontFamily">Cascadia Mono, Consolas, monospace</FontFamily>

    <!-- 4. 经典大药丸导航按钮样式 (UnturnedPillButtonStyle) -->
    <Style x:Key="UnturnedPillButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource UnturnedPillNormalBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UnturnedStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource UnturnedTextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UnturnedTitleFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="RootBorder"
                            CornerRadius="{StaticResource UnturnedPillCornerRadius}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 左侧高亮指示条 (选中时呈现) -->
                            <Rectangle x:Name="ActiveIndicator"
                                       Grid.Column="0"
                                       Width="4"
                                       Height="20"
                                       RadiusX="2"
                                       RadiusY="2"
                                       Fill="{StaticResource UnturnedAccentGoldBrush}"
                                       Margin="-6,0,10,0"
                                       Visibility="Collapsed" />

                            <ContentPresenter Grid.Column="1"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />

                            <!-- 键盘焦点外边框 -->
                            <Border x:Name="FocusRing"
                                    Grid.ColumnSpan="3"
                                    Margin="-2"
                                    BorderBrush="{StaticResource UnturnedAccentGoldBrush}"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource UnturnedPillHoverBrush}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource UnturnedStrokeStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource UnturnedPillPressedBrush}" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource UnturnedPillSelectedBrush}" />
                            <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource UnturnedAccentGoldBrush}" />
                            <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 5. 经典 HUD 半透明卡片样式 (UnturnedHudCardStyle) -->
    <Style x:Key="UnturnedHudCardStyle" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{StaticResource UnturnedCardCornerRadius}" />
        <Setter Property="Background" Value="{StaticResource UnturnedHudCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource UnturnedStrokeSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource UnturnedCardPadding}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

</ResourceDictionary>
