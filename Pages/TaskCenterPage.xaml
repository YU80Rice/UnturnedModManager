<Page x:Class="UnturnedModManager.Pages.TaskCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:UnturnedModManager.Controls"
      Title="任务中心"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="28,22,28,28" PreviewMouseWheel="Page_PreviewMouseWheel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,18">
            <controls:PageHeader Title="任务中心" Subtitle="查看社区插件安装、更新和卸载的实时进度、失败原因与操作历史。" />
            <ui:Button Content="清除已完成历史"
                       Icon="{ui:SymbolIcon Delete24}"
                       Appearance="Secondary"
                       Command="{Binding ClearHistoryCommand}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1"
                Padding="14,11"
                Margin="0,0,0,14"
                CornerRadius="10"
                Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <TextBlock Text="{Binding SummaryText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Border>

        <Border Grid.Row="2"
                CornerRadius="10"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <ListView ItemsSource="{Binding Tasks}"
                          BorderThickness="0"
                          Background="Transparent"
                          HorizontalContentAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18,14"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Padding="7,2" CornerRadius="7" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Stage}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="5" Margin="0,10,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <Border Background="{DynamicResource DangerSurfaceBrush}" Padding="10,7" CornerRadius="6" Margin="0,10,0,0" Visibility="{Binding HasFailureReason, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding FailureReason}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" />
                                        </Border>
                                        <TextBlock Text="{Binding AttemptText}" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding ProgressText}" HorizontalAlignment="Right" Margin="0,3,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Right" Margin="0,3,0,8" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:Button Content="重试" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" CommandParameter="{Binding}" Visibility="{Binding IsRetryAvailable, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Content="查看插件" Margin="0,8,0,0" Command="{Binding DataContext.OpenPluginCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" CommandParameter="{Binding}" Visibility="{Binding HasCommunityPlugin, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasTasks, Converter={StaticResource InverseBoolToVisibility}}">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="38" HorizontalAlignment="Center" />
                    <TextBlock Text="暂无任务" Margin="0,12,0,0" FontSize="16" HorizontalAlignment="Center" />
                    <TextBlock Text="从插件详情安装、更新或卸载后，进度和操作记录会出现在这里。" Margin="0,5,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
