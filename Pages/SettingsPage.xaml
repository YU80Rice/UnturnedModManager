<Page x:Class="UnturnedModManager.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:controls="clr-namespace:UnturnedModManager.Controls"
      Title="设置"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="CardPanel_PreviewMouseWheel">
        <StackPanel Margin="32,24,32,40" MaxWidth="820" HorizontalAlignment="Left">
            <controls:PageHeader Title="设置" Subtitle="配置游戏路径、社区账户与界面外观" Margin="0,0,0,22" />
            <ui:InfoBar x:Name="StatusInfoBar" IsOpen="False" Margin="0,0,0,16" />

            <Border CornerRadius="10" Padding="20" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Unturned 安装路径" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="请选择包含 Unturned.exe 的游戏根目录。"
                               Margin="0,3,0,12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="例如：E:\Steam\steamapps\common\Unturned" />
                        <ui:Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0"
                                   Command="{Binding BrowseCommand}" />
                        <ui:Button Grid.Column="2" Content="自动寻找" Icon="{ui:SymbolIcon Search16}"
                                   Margin="6,0,0,0" Command="{Binding DetectCommand}" />
                    </Grid>
                    <ProgressBar IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <Border CornerRadius="10" Padding="20" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="社区账户" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding AccountStatus}" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="{Binding AccountActionText}" Appearance="Primary"
                               VerticalAlignment="Center" Command="{Binding ManageAccountCommand}" />
                </Grid>
            </Border>

            <Border CornerRadius="10" Padding="20" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="主题模式" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="选择浅色、深色，或跟随 Windows 系统设置。"
                               Margin="0,3,0,12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox ItemsSource="{Binding ThemeChoices}"
                              SelectedItem="{Binding SelectedTheme}"
                              DisplayMemberPath="Label"
                              Width="220"
                              HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <Border CornerRadius="10" Padding="20" Margin="0,0,0,16"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="首次设置" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="可重新选择游戏目录和主题；不会删除插件、账户或现有配置。"
                                   Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ui:Button Grid.Column="1" Content="重新运行向导" Icon="{ui:SymbolIcon ArrowReset24}"
                               VerticalAlignment="Center" Command="{Binding RestartOnboardingCommand}" />
                </Grid>
            </Border>

            <ui:Button Content="保存设置" Icon="{ui:SymbolIcon Save24}"
                       Appearance="Primary" HorizontalAlignment="Left"
                       Command="{Binding SaveCommand}" />
        </StackPanel>
    </ScrollViewer>
</Page>
