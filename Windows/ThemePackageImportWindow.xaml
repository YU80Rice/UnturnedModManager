<Window x:Class="UnturnedModManager.Windows.ThemePackageImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="导入主题包审查向导 (.ummtheme)"
        Width="660" Height="620"
        MinWidth="540" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="18,14"
                CornerRadius="10"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Symbol="Color24"
                               FontSize="36"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                               VerticalAlignment="Top"
                               Margin="0,2,16,0" />

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ThemeNameText"
                               FontSize="18"
                               FontWeight="Bold"
                               Text="主题包名称" />
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock x:Name="ThemeAuthorText"
                                   Text="作者: -"
                                   FontSize="12"
                                   Margin="0,0,16,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ThemeVersionText"
                                   Text="版本: 1.0.0"
                                   FontSize="12"
                                   Margin="0,0,16,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="ThemeBaseText"
                                   Text="基底: 深色"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </WrapPanel>
                    <TextBlock x:Name="ThemeDescriptionText"
                               Text="说明信息..."
                               FontSize="12"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Preview Area -->
        <ScrollViewer Grid.Row="1" Margin="0,14,0,14" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Color Palette Card -->
                <Border Padding="16,12"
                        CornerRadius="8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="调色板与外观设计"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Accent Color Swatch -->
                            <Border Grid.Column="0" Margin="0,0,6,0" Padding="10" CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border x:Name="AccentSwatch" Width="36" Height="36" CornerRadius="18"
                                            BorderThickness="1" BorderBrush="#33000000" />
                                    <TextBlock Text="强调主色" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="AccentHexText" Text="#0078D4" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas, monospace" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Background Color Swatch -->
                            <Border Grid.Column="1" Margin="6,0,6,0" Padding="10" CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border x:Name="BgSwatch" Width="36" Height="36" CornerRadius="18"
                                            BorderThickness="1" BorderBrush="#33000000" />
                                    <TextBlock Text="页面背景色" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="BgHexText" Text="#1E1E1E" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas, monospace" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- Card Color Swatch -->
                            <Border Grid.Column="2" Margin="6,0,0,0" Padding="10" CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border x:Name="CardSwatch" Width="36" Height="36" CornerRadius="18"
                                            BorderThickness="1" BorderBrush="#33000000" />
                                    <TextBlock Text="卡片背景色" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="CardHexText" Text="#2D2D2D" FontSize="11" FontWeight="SemiBold" FontFamily="Consolas, monospace" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock x:Name="CardOpacityText" Text="卡片不透明度: 95%" FontSize="12" Margin="0,0,20,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="CardRadiusText" Text="卡片圆角: 10 px" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Wallpaper Preview Card -->
                <Border Padding="16,12"
                        CornerRadius="8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="背景壁纸资源"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Margin="0,0,0,8" />

                        <Grid x:Name="WallpaperPreviewContainer" Height="140">
                            <Border CornerRadius="6" ClipToBounds="True" Background="#0D000000">
                                <Image x:Name="WallpaperImage" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock x:Name="NoWallpaperText"
                                       Text="该主题未携带独立背景壁纸（使用纯色背景）"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Options Section -->
        <Border Grid.Row="2"
                Padding="14,10"
                CornerRadius="8"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                Margin="0,0,0,16">
            <CheckBox x:Name="ApplyImmediatelyCheckBox"
                      Content="导入后立即应用此主题（即刻换肤）"
                      IsChecked="True"
                      FontWeight="SemiBold"
                      FontSize="13" />
        </Border>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="取消"
                           MinWidth="84"
                           Margin="0,0,10,0"
                           Click="CancelButton_Click" />
                <ui:Button x:Name="ConfirmButton"
                           Content="确认导入"
                           Appearance="Primary"
                           MinWidth="110"
                           Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
