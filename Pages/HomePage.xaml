<Page x:Class="UnturnedModManager.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="开始游戏" Background="Transparent"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Page.Resources>
        <Style x:Key="BentoCard" TargetType="Border">
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="BentoTile" TargetType="Border" BasedOn="{StaticResource BentoCard}">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource AppCardBackgroundBrush2}"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Padding" Value="9,3"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <!-- A single active template prevents both welcome states from sharing the visual tree. -->
        <ControlTemplate x:Key="WelcomeExpandedTemplate" TargetType="ContentControl">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0.64*" MaxWidth="170"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <WrapPanel>
                        <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                            <TextBlock Text="UMM 欢迎区 · v3.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                        <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding WelcomeGreeting}"/>
                    </WrapPanel>
                    <TextBlock Text="让插件管理更轻松一点" FontSize="19" FontWeight="Bold" Margin="0,10,0,6" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding HomeAnnouncementHighlights}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,2">
                                    <Ellipse Width="5" Height="5" Margin="0,6,7,0" VerticalAlignment="Top" Fill="{DynamicResource AccentFillColorDefaultBrush}"/>
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <WrapPanel Margin="0,10,0,0">
                        <ui:Button Content="完整更新日志" Click="ShowChangeLog_Click" Margin="0,0,6,4"/>
                        <ui:Button Content="收起欢迎区" Command="{Binding HideHomeWelcomeCommand}" Margin="0,0,6,4"/>
                        <ui:Button Content="知道了" Command="{Binding AcknowledgeAnnouncementCommand}" Margin="0,0,0,4"
                                   Visibility="{Binding HasNewReleaseAnnouncement, Converter={StaticResource BoolToVisibility}}"/>
                    </WrapPanel>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding HasAvailableLauncherUpdate, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding LauncherUpdateDetail}"/>
                        <ui:Button Content="{Binding UpdateDownloadButtonText}" Appearance="Primary" Command="{Binding DownloadLauncherUpdateCommand}" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                        <StackPanel Visibility="{Binding IsDownloadingLauncherUpdate, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar Height="4" Margin="0,7,0,0" Maximum="100" Value="{Binding LauncherUpdatePercentage, Mode=OneWay}"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding LauncherUpdateText}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <Grid Grid.Column="1" Height="170" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Ellipse Width="138" Height="138" Fill="{DynamicResource AppMascotGlowBrush}" Stroke="{DynamicResource AppAccentBorderBrush}"/>
                    <Image Source="/Assets/umm-mascot-chibi-v2.png" Stretch="Uniform" VerticalAlignment="Stretch" AutomationProperties.Name="UMM 吉祥物"/>
                </Grid>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="WelcomeCollapsedTemplate" TargetType="ContentControl">
            <StackPanel VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}" HorizontalAlignment="Left"><TextBlock Text="欢迎区已收起" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/></Border>
                <TextBlock Text="保持专注的启动工作台" FontSize="19" FontWeight="SemiBold" Margin="0,10,0,5"/>
                <TextBlock Style="{StaticResource Caption}" Text="欢迎公告可随时恢复，也可从「游戏设置」重新开启。"/>
                <ui:Button Content="重新显示欢迎区" Command="{Binding ShowHomeWelcomeCommand}" Margin="0,10,0,0" HorizontalAlignment="Left"/>
            </StackPanel>
        </ControlTemplate>
    </Page.Resources>
    <ScrollViewer x:Name="RootScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly" PreviewMouseWheel="CardPanel_PreviewMouseWheel">
        <StackPanel Margin="28,20,28,26" MaxWidth="1280">
            <Border Style="{StaticResource BentoCard}" Margin="0,0,0,14"
                    Background="{DynamicResource DangerSurfaceBrush}" BorderBrush="{DynamicResource SystemFillColorCriticalBrush}"
                    Visibility="{Binding HasCrashAlert, Converter={StaticResource BoolToVisibility}}">
                <DockPanel LastChildFill="True">
                    <ui:Button DockPanel.Dock="Right" Content="忽略" Command="{Binding IgnoreCrashCommand}" Margin="12,0,0,0"/>
                    <TextBlock Text="检测到上次游戏异常退出，可在下方导出脱敏诊断包。" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="{DynamicResource DangerTextBrush}" FontWeight="SemiBold"/>
                </DockPanel>
            </Border>
            <Grid x:Name="BentoGrid">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.32*"/><ColumnDefinition x:Name="BentoSecondaryColumn" Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <Border x:Name="SummaryCard" Style="{StaticResource BentoCard}" Margin="0,0,14,14" MinHeight="226">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <Border Style="{StaticResource Chip}">
                                <TextBlock Text="全局启动指挥舱" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Border>
                            <Border DockPanel.Dock="Right" Padding="9,3" CornerRadius="12">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                        <Setter Property="Background" Value="{DynamicResource AppSuccessSurfaceBrush}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AppWarningSurfaceBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HasValidGamePath}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource AppWarningSurfaceBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding RuntimeStatusText}" FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource AppSuccessTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameRunning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource AppWarningTextBrush}"/></DataTrigger>
                                                <DataTrigger Binding="{Binding HasValidGamePath}" Value="False"><Setter Property="Foreground" Value="{DynamicResource AppWarningTextBrush}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DockPanel>
                        <TextBlock Text="运行概要与当前方案" FontSize="23" FontWeight="Bold" Margin="0,13,0,4"/>
                        <TextBlock Style="{StaticResource Caption}" Text="运行环境与启动入口位于底部指挥舱，在任意页面都可启动。"/>
                        <UniformGrid Columns="3" Rows="1" Margin="0,14,0,12">
                            <Border Style="{StaticResource BentoTile}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="当前方案"/><TextBlock Text="{Binding ActiveProfileName}" ToolTip="{Binding ActiveProfileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource BentoTile}" Margin="0,0,8,0">
                                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="启用模组"/><TextBlock Text="{Binding EnabledPluginsText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                            </Border>
                            <Border Style="{StaticResource BentoTile}">
                                <StackPanel><TextBlock Style="{StaticResource Caption}" Text="当前模式"/><TextBlock Text="{Binding ActiveRunModeText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                            </Border>
                        </UniformGrid>
                        <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,7,0,0">
                            <DockPanel>
                                <TextBlock Style="{StaticResource Caption}" Text="GAME ROOT" Margin="0,0,10,0" FontFamily="Consolas"/>
                                <TextBlock Text="{Binding GameRootPath}" ToolTip="{Binding GameRootPath}" TextAlignment="Right"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" FontFamily="Consolas"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="WelcomeCard" Grid.Column="1" Style="{StaticResource BentoCard}" Margin="0,0,0,14" ClipToBounds="True">
                    <ContentControl x:Name="WelcomeContent">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Template" Value="{StaticResource WelcomeExpandedTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomeWelcomeEnabled}" Value="False">
                                        <Setter Property="Template" Value="{StaticResource WelcomeCollapsedTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Border>

                <Border x:Name="EnvironmentCard" Grid.Row="1" Style="{StaticResource BentoCard}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="{Binding BepInExTitle}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding BepInExDetail}" Margin="0,4,0,0"/>
                        <WrapPanel Margin="0,8,0,0">
                            <ui:Button Content="一键安装 BepInEx" Appearance="Primary" Command="{Binding InstallCommand}" Margin="0,0,6,4"
                                       Visibility="{Binding CanInstallBepInEx, Converter={StaticResource BoolToVisibility}}"/>
                            <ui:Button Content="{Binding BepInExRepairButtonText}" Command="{Binding RepairCommand}" Margin="0,0,6,4"
                                       Visibility="{Binding IsBepInExInstalled, Converter={StaticResource BoolToVisibility}}"/>
                            <ui:Button Content="卸载" Foreground="{DynamicResource DangerTextBrush}" Command="{Binding UninstallCommand}" Margin="0,0,0,4"
                                       Visibility="{Binding IsBepInExInstalled, Converter={StaticResource BoolToVisibility}}"/>
                        </WrapPanel>
                        <UniformGrid Columns="2" Rows="1" Margin="0,6,0,0">
                            <Border Style="{StaticResource BentoTile}" Margin="0,0,8,0">
                                <DockPanel>
                                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding GlobalModsEnabled, Mode=TwoWay}" Command="{Binding ToggleGlobalModsCommand}"
                                                     Margin="6,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="全局模组环境"/>
                                    <StackPanel><TextBlock Text="全局模组环境" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Style="{StaticResource Caption}" Text="开启 BepInEx 加载"/></StackPanel>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource BentoTile}">
                                <DockPanel>
                                    <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding DxvkEnabled, Mode=TwoWay}" Command="{Binding ToggleDxvkCommand}"
                                                     Margin="6,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="DXVK 2.4 渲染"/>
                                    <StackPanel><TextBlock Text="DXVK 2.4 渲染" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Style="{StaticResource Caption}" Text="DX11 → Vulkan 转换"/></StackPanel>
                                </DockPanel>
                            </Border>
                        </UniformGrid>
                        <Border Style="{StaticResource BentoTile}" Margin="0,9,0,0">
                            <DockPanel>
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="19" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <StackPanel><TextBlock Text="{Binding GpuName}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Style="{StaticResource Caption}" Text="{Binding GpuRecommendation}"/></StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Border x:Name="DiagnosticsCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource BentoCard}">
                    <DockPanel LastChildFill="True">
                        <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <ui:Button Content="分析最近日志" Command="{Binding AnalyzeLogsCommand}" Margin="0,0,6,4"/>
                            <ui:Button Content="导出脱敏诊断包" Command="{Binding ExportLogsCommand}" Margin="0,0,0,4"/>
                        </WrapPanel>
                        <StackPanel>
                            <TextBlock Text="崩溃诊断与日志分析" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DiagnosticTitle}" FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding DiagnosticSummary}" Margin="0,4,0,0"/>
                            <Border Style="{StaticResource BentoTile}" Margin="0,9,0,0" Visibility="{Binding HasDiagnosticRecommendation, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding DiagnosticRecommendation, StringFormat=排障建议：{0}}" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding DiagnosticDetail}" FontFamily="Consolas" Margin="0,8,0,0"
                                       Visibility="{Binding HasDiagnosticDetail, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource BentoCard}" Margin="0,14,0,0" Visibility="{Binding HasOperationProgress, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Right" Content="取消当前操作" Command="{Binding CancelOperationCommand}" Margin="12,0,0,0"/>
                    <StackPanel><TextBlock Style="{StaticResource Caption}" Text="{Binding OperationText}"/><ProgressBar Maximum="100" Height="5" Margin="0,7,0,0" Value="{Binding OperationPercentage, Mode=OneWay}"/></StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
