<Window x:Class="UnturnedModManager.Windows.ModPackageImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="导入模组包审查向导 (.ummpk)"
        Width="700" Height="640"
        MinWidth="580" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Package Metadata Header -->
        <Border Grid.Row="0"
                Padding="18,14"
                CornerRadius="10"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Symbol="FolderZip24"
                               FontSize="36"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                               VerticalAlignment="Top"
                               Margin="0,2,16,0" />

                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="PackageNameText"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="模组包名称" />
                    <WrapPanel Margin="0,6,0,0">
                        <TextBlock x:Name="PackageAuthorText"
                                   Text="作者: -"
                                   FontSize="12"
                                   Margin="0,0,16,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="PackageVersionText"
                                   Text="版本: 1.0.0"
                                   FontSize="12"
                                   Margin="0,0,16,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="PackageDateText"
                                   Text="导出时间: -"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </WrapPanel>
                    <TextBlock x:Name="PackageDescriptionText"
                               Text="说明信息..."
                               FontSize="12"
                               Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Profile Target & Conflict Options -->
        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Target Profile Selection -->
            <Border Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="14,10"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="目标插件方案 (Profile)"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ComboBox x:Name="ProfileComboBox"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>

            <!-- Conflict Policy -->
            <Border Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="14,10"
                    CornerRadius="8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="冲突保护选项"
                               FontWeight="SemiBold"
                               FontSize="13"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <CheckBox x:Name="PreserveConfigCheckBox"
                              Content="保留本地已有配置 (.cfg)"
                              IsChecked="True"
                              Margin="0,6,0,0"
                              FontSize="12"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <CheckBox x:Name="BackupDllCheckBox"
                              Content="覆盖 .dll 时自动备份为 .bak"
                              IsChecked="True"
                              IsEnabled="False"
                              FontSize="12"
                              Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Entries & Conflict Preview -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="FilesSummaryText"
                       Grid.Row="0"
                       Text="将导入的文件清单（共 0 项）："
                       FontWeight="SemiBold"
                       FontSize="13"
                       Margin="0,0,0,6"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <Border Grid.Row="1"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <ListView x:Name="EntriesListView"
                          BorderThickness="0"
                          Background="Transparent"
                          Padding="4">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:SymbolIcon Symbol="Document24"
                                               FontSize="20"
                                               Margin="0,0,10,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding RelativePath}"
                                               FontFamily="Consolas, monospace"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Border Grid.Column="2"
                                        Padding="6,2"
                                        CornerRadius="4"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConflictType}" Value="New">
                                                    <Setter Property="Background" Value="#26107C41" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConflictType}" Value="ConflictDll">
                                                    <Setter Property="Background" Value="#33FFB900" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ConflictType}" Value="ConflictConfig">
                                                    <Setter Property="Background" Value="#260078D4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ConflictType}" Value="New">
                                                        <Setter Property="Text" Value="全新文件" />
                                                        <Setter Property="Foreground" Value="#107C41" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ConflictType}" Value="ConflictDll">
                                                        <Setter Property="Text" Value="版本覆盖 (.bak备份)" />
                                                        <Setter Property="Foreground" Value="#D83B01" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ConflictType}" Value="ConflictConfig">
                                                        <Setter Property="Text" Value="保留本地配置" />
                                                        <Setter Property="Foreground" Value="#0078D4" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <!-- Action Bar -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="取消"
                           MinWidth="84"
                           Margin="0,0,10,0"
                           Click="CancelButton_Click" />
                <ui:Button x:Name="ConfirmButton"
                           Content="确认导入"
                           Appearance="Primary"
                           MinWidth="110"
                           Click="ConfirmButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
