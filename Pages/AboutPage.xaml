<Page x:Class="UnturnedModManager.Pages.AboutPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="关于"
      Background="{DynamicResource ApplicationBackgroundBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PreviewMouseWheel="CardPanel_PreviewMouseWheel">
    <Grid Margin="48,32,48,48">
    <StackPanel MaxWidth="1200"
                HorizontalAlignment="Stretch">

        <Border CornerRadius="14"
                Padding="48,36"
                Margin="0,0,0,28"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Width="76"
                        Height="76"
                        CornerRadius="18"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center">
                    <Viewbox Width="40" Height="40">
                        <ui:SymbolIcon Symbol="Box24" Foreground="White" />
                    </Viewbox>
                </Border>

                <TextBlock Grid.Row="1"
                           Text="Unturned Mod Manager"
                           FontSize="38"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <Border Grid.Row="2"
                        CornerRadius="6"
                        Padding="14,6"
                        Margin="0,16,0,20"
                        HorizontalAlignment="Stretch"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock Text="v2.1.7 · Stable · 2026-08-19"
                               FontSize="12"
                               FontWeight="SemiBold"
                               FontFamily="Cascadia Mono, Consolas, monospace"
                               TextAlignment="Center"
                               HorizontalAlignment="Stretch"
                               Foreground="White" />
                </Border>

                <TextBlock Grid.Row="3"
                           Text="面向 Windows 的 Unturned 启动、BepInEx 插件管理与 unmod.online 社区客户端。"
                           FontSize="14"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           LineHeight="22"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Grid.Row="4" Margin="0,18,0,0" FontSize="13" HorizontalAlignment="Center">
                    <Hyperlink NavigateUri="https://github.com/YU80Rice/UnturnedModManager"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                               TextDecorations="Underline"
                               FontWeight="SemiBold"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="GitHub：YU80Rice/UnturnedModManager" />
                    </Hyperlink>
                </TextBlock>
            </Grid>
        </Border>

        <Grid Margin="4,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="4"
                    Height="18"
                    CornerRadius="2"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
            <TextBlock Grid.Column="1"
                       Text="项目贡献者与协作者"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
        </Grid>

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Grid.Column="0"
                    CornerRadius="12"
                    Padding="24"
                    Margin="0,0,8,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="👤 YU80Rice"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="项目发起人、产品负责人"
                               Margin="0,6,0,12"
                               FontSize="12"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="提出产品目标和功能需求，决定技术路线与许可证，负责体验验收、发布和社区运营。"
                               FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="19"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1"
                    CornerRadius="12"
                    Padding="24"
                    Margin="8,0,0,8"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="🤖 OpenAI GPT（Codex）"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="v2.0–v2.1 开发协作者"
                               Margin="0,6,0,12"
                               FontSize="12"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="参与架构重构、交互完善、社区缓存、账户会话可靠性、任务中心与图片预览、自动化测试、发布验证，以及 README、更新日志和关于页的严谨化校订。"
                               FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="19"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0"
                    CornerRadius="12"
                    Padding="24"
                    Margin="0,8,8,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="🧠 AI 协作伙伴"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="Gemini · Claude · Kimi · Cherry Claw"
                               Margin="0,6,0,12"
                               FontSize="12"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="在项目不同阶段参与架构讨论、问题分析、代码生成与本地执行。AI 协作不替代维护者对功能、许可和发布结果承担的责任。"
                               FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="19"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1"
                    CornerRadius="12"
                    Padding="24"
                    Margin="8,8,0,0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="🧭 Ayndpa"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="UML 作者、UMM 贡献者"
                               Margin="0,6,0,10"
                               FontSize="12"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock FontSize="12"
                               TextWrapping="Wrap"
                               LineHeight="19"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="感谢 " />
                        <Hyperlink NavigateUri="https://github.com/Ayndpa/unturned-mod-loader"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                   RequestNavigate="Hyperlink_RequestNavigate">
                            <Run Text="unturned-mod-loader" />
                        </Hyperlink>
                        <Run Text=" 在信息架构、社区流程和导航交互方面提供的重要参考；Ayndpa 还通过 UMM PR #7 直接贡献了滚轮交互修复。" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <ui:Card Margin="0,0,0,24" Padding="36,30">
            <StackPanel>
                <TextBlock Text="项目初心：创意工坊赋予血肉，UMM 重塑筋骨"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,18" />
                <Border Height="1"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Margin="0,0,0,20" />

                <TextBlock Text="我们并不是要挑战 Steam 创意工坊——恰恰相反，我们极度热爱它。创意工坊让玩家获得地图、武器、载具和无数社区内容，为 Unturned 提供了丰富而鲜活的“血肉”。"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="23"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,14" />

                <TextBlock Text="UMM 最初想填补的是另一块空白：客户端逻辑插件、加载器环境、依赖与版本管理，以及玩家对自己本地游戏环境的掌控。创意工坊决定玩家“玩到什么”，UMM 希望帮助玩家更自由地决定“怎么玩”。"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="23"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,14" />

                <TextBlock Text="我们希望它成为一个开放的、属于玩家自己的底层逻辑引导与开发平台：把手动复制 DLL、修改文件名和排查依赖的过程，变成看得见、可理解、可撤销的操作。这个项目也承载着人与朋友们在 PEI 篝火旁度过的记忆——它不是冷冰冰的功能集合，而是一封写给 Unturned 社区的信。"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="23"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,14" />

                <TextBlock Text="当前版本采用社区统一基线 BepInEx 5.4.23.5（win_x64，Unity Mono / winhttp doorstop），支持安装、升级、修复、临时停用与保留玩家插件数据的核心环境卸载。"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="23"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Text="安装包下载按“已登录的 unmod.online 社区源 → gh-proxy.com / ghproxy.net 国内镜像 → GitHub 官方”顺序回退；未登录时会明确跳过需要账户 Cookie 的社区源。无论来自哪个源，安装前都会校验同一份官方 SHA-256。"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="23"
                           Margin="0,14,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Text="v2.1 在此基础上增加封面与详情图片预览，以及可记录进度、失败原因和重试的插件任务中心。UMM 不采用 WinFsp 虚拟盘或挂载式多 profile，以避免 Unity 对虚拟文件系统读取不兼容的风险。"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="23"
                           Margin="0,14,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <TextBlock Text="UMM 使用自身的 umm:// 协议打开社区详情，并通过单实例唤醒避免多个窗口同时修改游戏插件目录；不会覆盖 UML 的 unmod:// 协议。"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="23"
                           Margin="0,14,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,24" Padding="36,30">
            <StackPanel>
                <TextBlock Text="Vibecoding：坦诚的人机协作"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,18" />
                <Border Height="1"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Margin="0,0,0,20" />

                <TextBlock Text="UMM 从一开始就是一次坦诚的人机协作实践：人类提出愿景、审美和真实需求，AI 协作者参与架构推演、代码实现、问题诊断和文档整理，再由维护者进行选择、试用和验收。我们不把 AI 参与隐藏在“全自研”的叙事后面，也不把 AI 输出当作天然正确的答案。"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="23"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,14" />

                <TextBlock Text="Vibecoding 的意义，不是让 AI 替人负责，而是让一个可能因经验、时间和信心不足而停留在想法里的社区项目真正落地。OpenAI GPT（Codex）、Gemini、Claude、Kimi、Cherry Claw 等协作者在不同阶段留下了贡献；最终的功能取舍、许可证、发布和用户责任仍由项目维护者承担。"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="23"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,24" Padding="36,30">
            <StackPanel>
                <TextBlock Text="设计学习与独立实现"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,18" />
                <Border Height="1"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Margin="0,0,0,20" />

                <TextBlock FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="23"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,14">
                    <Run Text="UMM v2.0 明确借鉴并学习了 " />
                    <Hyperlink NavigateUri="https://github.com/Ayndpa/unturned-mod-loader"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                               RequestNavigate="Hyperlink_RequestNavigate">
                        <Run Text="Ayndpa/unturned-mod-loader" />
                    </Hyperlink>
                    <Run Text=" 的信息组织、社区浏览和登录流程，并参考 PCL2 等成熟启动器的列表—详情体验。感谢这些项目公开成果所带来的启发。" />
                </TextBlock>

                <TextBlock Text="UMM 不是 UML 的官方分支或继任版本。当前版本保留 .NET 8 + WPF 路线，并针对自身服务层、状态模型、文件清单、安装回滚和导航上下文进行了独立实现。各第三方项目继续适用各自许可证。"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="23"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,24" Padding="36,30">
            <StackPanel>
                <TextBlock Text="开源许可与免责声明"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Margin="0,0,0,18" />
                <Border Height="1"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}"
                        Margin="0,0,0,20" />

                <TextBlock Text="UMM v2.0 及之后版本按 GNU General Public License version 2 发布，SPDX 标识为 GPL-2.0-only。您可以运行、研究、修改和再分发；如果向他人分发本项目或其 GPL 衍生版本，必须继续使用 GPL v2，并按许可证要求提供相应源代码和许可声明。仅在本地使用且未对外分发的修改，不会自动产生公开发布义务。GPL 保障软件自由，但并不禁止收费。"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="23"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,14" />

                <TextBlock Text="Unturned 及其相关商标和游戏资产归 Smartly Dressed Games 所有。本项目按 GPL 的“按现状”条款提供，不附带适销性、特定用途适用性或不侵权保证。WPF-UI、BepInEx、DXVK、UML 及其他第三方项目仍受各自许可证约束。"
                           FontSize="13"
                           TextWrapping="Wrap"
                           LineHeight="23"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>

        <StackPanel HorizontalAlignment="Center" Margin="0,8,0,0">
            <TextBlock Text="Copyright © 2026 YU80Rice and contributors"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       FontFamily="Cascadia Mono, Consolas, monospace"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock Text=".NET 8 · WPF-UI · GPL-2.0-only"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0"
                       FontFamily="Cascadia Mono, Consolas, monospace"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </StackPanel>
    </Grid>
    </ScrollViewer>
</Page>
