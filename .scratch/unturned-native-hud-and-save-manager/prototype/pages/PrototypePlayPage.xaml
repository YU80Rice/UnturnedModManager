<Page x:Class="UnturnedModManager.Prototypes.PrototypePlayPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PrototypePlayPage"
      Background="Transparent">

    <ScrollViewer x:Name="PlayRootScrollViewer"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False">
        <StackPanel Margin="0,0,16,24">

            <!-- 1. 关键状态横幅 (Critical Status Banner) -->
            <Border x:Name="StatusBanner"
                    Margin="0,0,0,16"
                    CornerRadius="6"
                    Padding="14,10"
                    Background="#D015241B"
                    BorderBrush="#FF38A169"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🛡️" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="12">
                        <Run Text="运行状态就绪：" FontWeight="Bold" />
                        <Run Text="已开启纯净模组环境 (winhttp / -NoBattlEye)，无崩溃与冲突。" Foreground="#FFCBD5E0" />
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="BE 5.4.23.5" Foreground="#FF38A169" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- 2. 主启动舞台与当前方案卡片 (Main Launch Stage) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧：大号英雄启动卡片 (Hero Launch Card) -->
                <Border x:Name="LaunchHeroCard"
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        Style="{DynamicResource UnturnedHudCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Unturned Mod Manager"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFFFF"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="让插件管理与游戏启动更安全可靠。"
                                   FontSize="12"
                                   Foreground="#FFCBD5E0"
                                   Margin="0,0,0,16" />

                        <!-- 大号原生风格启动按钮 (Hero Play Button) -->
                        <Button Height="52"
                                Background="#D8236B3D"
                                BorderBrush="#FF38A169"
                                BorderThickness="2"
                                CornerRadius="8"
                                Cursor="Hand">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="▶" FontSize="18" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="启动游戏 (模组模式)" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock Text="路径: E:\Steam\steamapps\common\Unturned"
                                   FontSize="11"
                                   Foreground="#FF718096"
                                   Margin="0,10,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 右侧：方案状态与吉祥物适配器挂件 (Profile & Mascot Widget) -->
                <Border Grid.Column="1"
                        Style="{DynamicResource UnturnedHudCardStyle}">
                    <Grid>
                        <!-- 正常方案内容 -->
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="当前配置方案"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF"
                                       Margin="0,0,0,8" />
                            <Border Background="#40000000" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                <TextBlock Text="默认联机优化方案 (12 Mods)"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="#FFE2B024" />
                            </Border>

                            <!-- 吉祥物开关演示按钮 (用于验证吉祥物关闭后的布局完整性) -->
                            <Button x:Name="MascotToggleBtn"
                                    Height="32"
                                    Background="#401A2026"
                                    BorderBrush="#FF4A5568"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Content="🦊 切换吉祥物挂件显隐"
                                    Foreground="#FFCBD5E0"
                                    FontSize="11"
                                    Click="MascotToggleBtn_Click" />
                        </StackPanel>

                        <!-- 可插拔吉祥物悬浮挂件 (MascotPresentationAdapter) -->
                        <Border x:Name="MascotContainer"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Margin="0,50,0,-10"
                                Width="110"
                                Height="110"
                                Visibility="Visible">
                            <TextBlock Text="🦊" FontSize="70" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.9" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. 下半区：精选模组与版本要点 (Featured Mods & Patch Notes) -->
            <Grid x:Name="FeaturedGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 精选模组推荐 (Featured Mod Card) -->
                <Border Grid.Column="0"
                        Margin="0,0,12,0"
                        Style="{DynamicResource UnturnedHudCardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="精选创意工坊 / 推荐插件"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFFFFF" />
                            <TextBlock Text="社区认证"
                                       HorizontalAlignment="Right"
                                       FontSize="10"
                                       Foreground="#FF38A169"
                                       FontWeight="Bold" />
                        </Grid>
                        <Border Height="80" CornerRadius="6" Background="#30000000" Padding="12" Margin="0,0,0,10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BetterUnturnedExperience (BUE)" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF" />
                                <TextBlock Text="现代化游戏体验与交互优化组件" FontSize="11" Foreground="#FFCBD5E0" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 更新公告 (Patch Notes Card) -->
                <Border Grid.Column="1"
                        Style="{DynamicResource UnturnedHudCardStyle}">
                    <StackPanel>
                        <TextBlock Text="v2.2.1 Patch Notes"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFFFFFF"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="• 新增玩家自定义全屏壁纸与毛玻璃模糊。" FontSize="11" Foreground="#FFCBD5E0" Margin="0,0,0,4" />
                        <TextBlock Text="• 接入 PreviewMouseWheel 隧道路由，修复滚轮卡滞。" FontSize="11" Foreground="#FFCBD5E0" Margin="0,0,0,4" />
                        <TextBlock Text="• 建立 Unturned 原生 UI Shell 空间原型与设计代币。" FontSize="11" Foreground="#FFE2B024" />
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
